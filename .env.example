# =============================================================
# Tonelify environment variables
#
# Local development : copy this file to .env.local and fill it in
# Production        : set the same keys in Vercel
#                     Project > Settings > Environment Variables > Production
#
# Editing .env.local does NOT change the live site. Production reads
# only from Vercel. Anything meant for tonelify.com goes in both places.
# =============================================================


# -------------------------------------------------------------
# STRIPE
#
# Every Stripe value below must come from the SAME account:
#   Tonelify account : acct_1SzcmNIpH3A3WvtI
#
# Do NOT use keys from acct_1SOb4IEan7dFAO9m. That is the agency
# account (Ad Automation, WhatsApp, Voice Agent). Production was
# pointed at it by mistake, which is why checkout returned 500.
# -------------------------------------------------------------

# Dashboard > Developers > API keys
#   .env.local        : TEST keys  (sk_test_... / pk_test_...)
#   Vercel production : LIVE keys  (sk_live_... / pk_live_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
# Starts with whsec_
#
# Create the production endpoint in LIVE mode:
#   URL    : https://tonelify.com/api/stripe/webhook
#   Events : checkout.session.completed
#            invoice.payment_succeeded
#            customer.subscription.updated
#            customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=


# -------------------------------------------------------------
# STRIPE PRICES
#
# These are PRICE ids and start with price_
# They are NOT the product ids that start with prod_
#
# To find one: Dashboard > Products > open the product >
# Pricing section > the "..." menu on the price row > Copy price ID
#
# Test mode and live mode have different ids for the same price,
# so .env.local and Vercel will not match here. That is expected.
# -------------------------------------------------------------

# Tonelify Week Pass, $4.99 per week. WITHDRAWN August 2026: the live product
# prod_Ux2kg7NN5eoVv1 is archived and checkout on its price is refused. Nothing
# reads this variable any more; it is kept only so an old value in a deployment
# is recognisable rather than mysterious.
STRIPE_PRICE_WEEK_PASS=

# Headliner, $12.99 per month and $59.99 per year.
#
# In live mode these two prices sit on TWO different products
# (prod_Ux3Ui5KeYvOjre monthly, prod_Ux3VJmOKRwOSKs yearly) because the product
# was created twice. Checkout is unaffected, it resolves a price id directly,
# but the Billing Portal lists plans per product, so monthly and yearly do not
# appear as two intervals of one plan there. Put both on one product before
# relying on the portal for interval switching.
STRIPE_PRICE_PLAYER_MONTHLY=

STRIPE_PRICE_PLAYER_ANNUAL=

# Stage tier, $6.99 per month and $39.99 per year. Create both prices in Stripe,
# then paste the ids here and in the Vercel project.
#
# Until BOTH are set the Stage card is not rendered and /plans shows Headliner
# alone. That is deliberate: isPlanConfigured() in lib/stripe.ts hides any tier
# whose prices are missing, so a visitor can never be shown a plan that checkout
# would answer with "No such price". The same check now covers Headliner, so an
# environment with neither pair set renders no pricing section at all.
STRIPE_PRICE_STAGE_MONTHLY=
STRIPE_PRICE_STAGE_ANNUAL=


# -------------------------------------------------------------
# SITE
# Used to build Stripe success and cancel URLs. Without it,
# checkout falls back to the request origin.
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tonelify.com


# -------------------------------------------------------------
# CLERK (auth)
# Dashboard > API keys
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/tone-match
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/tone-match


# -------------------------------------------------------------
# SUPABASE
# Project settings > API. The service key bypasses row level
# security, so keep it server side only.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=


# -------------------------------------------------------------
# OPENAI
# Powers tone research and adaptation.
# -------------------------------------------------------------
OPENAI_API_KEY=


# -------------------------------------------------------------
# ADMIN
#
# Who can open /admin/feedback, which is where the /feedback form's
# messages are read. There is no notification mail: the table is the
# inbox.
#
# Comma separated Clerk user ids, e.g. user_2ab...,user_2cd...
# To find yours: Clerk dashboard > Users > open your user > copy the
# User ID at the top, or read it from the session on any signed-in page.
#
# Empty denies everyone, including you. That is deliberate: a deploy that
# forgets this variable must lock the page rather than publish it. Do NOT
# rename it to NEXT_PUBLIC_, it is read server side only.
# -------------------------------------------------------------
ADMIN_USER_IDS=


# -------------------------------------------------------------
# UPSTASH REDIS
# Caches iTunes lookups and rate limits the song search endpoint.
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
