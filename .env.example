# =============================================================
# Tonelify environment variables
#
# Local development : copy this file to .env.local and fill it in
# Production        : set the same keys in Vercel
#                     Project > Settings > Environment Variables > Production
#
# Editing .env.local does NOT change the live site. Production reads
# only from Vercel. Anything meant for tonelify.com goes in both places.
# =============================================================


# -------------------------------------------------------------
# STRIPE
#
# Every Stripe value below must come from the SAME account:
#   Tonelify account : acct_1SzcmNIpH3A3WvtI
#
# Do NOT use keys from acct_1SOb4IEan7dFAO9m. That is the agency
# account (Ad Automation, WhatsApp, Voice Agent). Production was
# pointed at it by mistake, which is why checkout returned 500.
# -------------------------------------------------------------

# Dashboard > Developers > API keys
#   .env.local        : TEST keys  (sk_test_... / pk_test_...)
#   Vercel production : LIVE keys  (sk_live_... / pk_live_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
# Starts with whsec_
#
# Create the production endpoint in LIVE mode:
#   URL    : https://tonelify.com/api/stripe/webhook
#   Events : checkout.session.completed
#            invoice.payment_succeeded
#            customer.subscription.updated
#            customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=


# -------------------------------------------------------------
# STRIPE PRICES
#
# These are PRICE ids and start with price_
# They are NOT the product ids that start with prod_
#
# To find one: Dashboard > Products > open the product >
# Pricing section > the "..." menu on the price row > Copy price ID
#
# Test mode and live mode have different ids for the same price,
# so .env.local and Vercel will not match here. That is expected.
# -------------------------------------------------------------

# Tonelify Week Pass, $4.99 per week
# product: prod_Ux2kg7NN5eoVv1
STRIPE_PRICE_WEEK_PASS=

# Tonelify Player Monthly, $12.99 per month
# product: prod_Ux3Ui5KeYvOjre
STRIPE_PRICE_PLAYER_MONTHLY=

# Tonelify Player Yearly, $59.99 per year
# product: prod_Ux3VJmOKRwOSKs
STRIPE_PRICE_PLAYER_ANNUAL=


# -------------------------------------------------------------
# SITE
# Used to build Stripe success and cancel URLs. Without it,
# checkout falls back to the request origin.
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tonelify.com


# -------------------------------------------------------------
# CLERK (auth)
# Dashboard > API keys
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/tone-match
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/tone-match


# -------------------------------------------------------------
# SUPABASE
# Project settings > API. The service key bypasses row level
# security, so keep it server side only.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=


# -------------------------------------------------------------
# OPENAI
# Powers tone research and adaptation.
# -------------------------------------------------------------
OPENAI_API_KEY=


# -------------------------------------------------------------
# UPSTASH REDIS
# Caches iTunes lookups and rate limits the song search endpoint.
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
